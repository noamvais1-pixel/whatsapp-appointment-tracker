# Copy this file to .env and fill it in.

# Your Gemini API key (https://aistudio.google.com/apikey). Required.
GEMINI_API_KEY=

# Which Gemini model reads the chats. A FREE key gets only ~20 requests a DAY on gemini-3.5-flash / 3.8-flash,
# so the default is the lite model. With billing enabled, gemini-3.5-flash or gemini-3.8-flash are better.
GEMINI_MODEL=gemini-3.5-flash-lite

# Used automatically when the main model is overloaded. Leave blank to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash

# Minimum gap between Gemini requests, in milliseconds. Keeps a free key inside its per-minute limit.
# If you enable billing on your key you can lower this to 1000.
GEMINI_MIN_INTERVAL_MS=13000

# Your local timezone, so "tomorrow at 3" resolves correctly.
# Leave blank to use this Mac's timezone.
TIMEZONE=

# How many days of chat history to read the first time you link a phone.
BACKFILL_DAYS=14

# Skip group chats (true/false). Groups are usually noise.
IGNORE_GROUPS=true

# Optional: only read these chats (comma-separated names or phone numbers). Leave blank for all.
ONLY_CHATS=

# Optional: never read these chats (comma-separated names or phone numbers).
SKIP_CHATS=

# If you wrote last in a chat and got no answer for this many hours, add a follow-up reminder. 0 = off.
NO_REPLY_HOURS=24

# Keep the Mac awake while the tracker runs (it cannot read messages while the Mac sleeps). true/false.
# Closing the lid still puts the Mac to sleep.
KEEP_AWAKE=true

# Meetings/calls whose time passed this many hours ago are closed automatically (0 = never).
AUTO_CLOSE_PAST_HOURS=12

# Web dashboard port
PORT=3123

# Optional: send yourself a daily agenda on WhatsApp at this time (24h HH:MM). Leave blank to disable.
DAILY_DIGEST_TIME=

# Path to Chrome. Defaults to the Google Chrome installed in /Applications.
CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
